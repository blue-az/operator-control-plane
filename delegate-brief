#!/usr/bin/env bash
#
# delegate-brief — launch a headless harness run against a written brief, with the
# brief preserved in the workspace and declared frozen paths checked mechanically.
#
# Rebuilt from the grok delegation recovered in ~/.grok/sessions (task
# kernelcad-forehand-aw-mount, 2026-08-07 21:09). That launch worked, but three
# properties of it caused the incident recorded in the ledger:
#
#   1. The brief existed only in the child process's argv. It did not survive the
#      process, so the agent that later picked up the workspace never saw the freeze,
#      the deliverable path, or the acceptance checklist. Here the brief is passed by
#      file and copied into the deliverable directory as .brief.md.
#   2. Frozen paths were stated in prose and honored by hope. Here they are hashed
#      before and after; a violation is reported and exits non-zero.
#   3. The run died leaving 15 bytes ("Execution error") in a log nobody read, and its
#      exit code was lost. Here the full log and exit code are captured and surfaced.
#
# Permission bypass is opt-in, not the default. The original used
# --dangerously-skip-permissions.
#
set -uo pipefail

TASK=""
BRIEF=""
WORK_CWD="$PWD"
DELIVER=""
PROMPT=""
MODEL=""
ALLOWED=""
TIMEOUT=1800
LOG=""
RECORD=0
DRY=0
SKIP_PERMS=0
FREEZE=()

usage() {
    cat <<'EOF'
Usage: delegate-brief --task ID --brief FILE [options]

Required:
  --task ID              Operator task id this run is delegated under.
  --brief FILE           Markdown brief. Passed via --append-system-prompt-file
                         (not argv) and copied to DELIVER/.brief.md.

Options:
  --cwd DIR              Working directory for the run (default: current).
                         Must be the directory whose MCP servers you need.
  --deliver DIR          Deliverable directory. Created if absent; receives .brief.md.
  --freeze PATH          Path that must not change. Repeatable. Hashed before/after.
  --prompt TEXT          Kickoff prompt (default: execute the brief, do not deploy).
  --allowed-tools LIST   Comma/space list, e.g. 'mcp__kernelcad__*,Bash,Read,Write,Edit'.
  --model NAME           Model override.
  --timeout SECS         Hard wall clock limit (default: 1800).
  --log FILE             Log path (default: <deliver-or-tmp>/delegate-<task>-<ts>.log).
  --skip-permissions     Pass --dangerously-skip-permissions. Off by default.
  --record               On exit, append an operator handoff with the real outcome.
  --dry-run              Print the command and the freeze manifest, run nothing.
  -h, --help             This message.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --task)            TASK="$2"; shift 2 ;;
        --brief)           BRIEF="$2"; shift 2 ;;
        --cwd)             WORK_CWD="$2"; shift 2 ;;
        --deliver)         DELIVER="$2"; shift 2 ;;
        --freeze)          FREEZE+=("$2"); shift 2 ;;
        --prompt)          PROMPT="$2"; shift 2 ;;
        --allowed-tools)   ALLOWED="$2"; shift 2 ;;
        --model)           MODEL="$2"; shift 2 ;;
        --timeout)         TIMEOUT="$2"; shift 2 ;;
        --log)             LOG="$2"; shift 2 ;;
        --skip-permissions) SKIP_PERMS=1; shift ;;
        --record)          RECORD=1; shift ;;
        --dry-run)         DRY=1; shift ;;
        -h|--help)         usage; exit 0 ;;
        *) printf 'delegate-brief: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

die() { printf 'delegate-brief: %s\n' "$1" >&2; exit 2; }

[ -n "$TASK" ]  || die "--task is required"
[ -n "$BRIEF" ] || die "--brief is required"
[ -f "$BRIEF" ] || die "brief not found: $BRIEF"
[ -d "$WORK_CWD" ] || die "cwd not found: $WORK_CWD"
command -v claude >/dev/null || die "claude not on PATH"

BRIEF_ABS=$(readlink -f "$BRIEF")
WORK_CWD=$(readlink -f "$WORK_CWD")
TS=$(date +%Y%m%dT%H%M%S)

if [ -n "$DELIVER" ]; then
    mkdir -p "$DELIVER" || die "cannot create deliverable dir: $DELIVER"
    DELIVER=$(readlink -f "$DELIVER")
fi
if [ -z "$LOG" ]; then
    LOG="${DELIVER:-/tmp}/delegate-${TASK}-${TS}.log"
fi

# ---- freeze manifest -------------------------------------------------------
manifest() {
    local p="$1"
    if [ -d "$p" ]; then
        find "$p" -type f -print0 2>/dev/null | LC_ALL=C sort -z \
            | xargs -0 -r sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1
    elif [ -f "$p" ]; then
        sha256sum "$p" | cut -d' ' -f1
    else
        printf 'ABSENT'
    fi
}

declare -A BEFORE
for p in ${FREEZE+"${FREEZE[@]}"}; do
    abs=$(readlink -f "$p" 2>/dev/null || printf '%s' "$p")
    BEFORE["$abs"]=$(manifest "$abs")
    if [ "${BEFORE[$abs]}" = "ABSENT" ]; then
        printf 'delegate-brief: warning: frozen path does not exist: %s\n' "$abs" >&2
    fi
done

# ---- MCP preflight ---------------------------------------------------------
# The original failed partly because the connector only exists for one project dir.
if [ -n "$ALLOWED" ] && printf '%s' "$ALLOWED" | grep -q 'mcp__'; then
    # Server names may themselves contain underscores (mcp__claude_ai_Gmail__send), so
    # split on the '__' delimiter rather than excluding '_' from the name.
    srv=$(printf '%s' "$ALLOWED" | tr ', ' '\n\n' | sed -n 's/^mcp__\(..*\)$/\1/p' \
            | sed 's/__.*$//' | sort -u)
    for s in $srv; do
        # Project-scoped servers are only visible from the project directory.
        if ! (cd "$WORK_CWD" && claude mcp list 2>/dev/null) | grep -q "\b${s}\b"; then
            printf 'delegate-brief: warning: MCP server %s not listed for cwd %s\n' \
                "$s" "$WORK_CWD" >&2
        fi
    done
fi

# ---- assemble --------------------------------------------------------------
if [ -z "$PROMPT" ]; then
    PROMPT="Execute the brief in your system prompt for Operator task ${TASK}. Honor every constraint in it literally, including any frozen paths and deliverable-path restrictions. Do not deploy to production. If the brief conflicts with anything else you are told, stop and report the conflict rather than choosing."
fi

CMD=(claude -p "$PROMPT" --append-system-prompt-file "$BRIEF_ABS")
[ -n "$ALLOWED" ] && CMD+=(--allowedTools "$ALLOWED")
[ -n "$MODEL" ]   && CMD+=(--model "$MODEL")
[ "$SKIP_PERMS" -eq 1 ] && CMD+=(--dangerously-skip-permissions)

if [ "$DRY" -eq 1 ]; then
    printf 'cwd     : %s\n' "$WORK_CWD"
    printf 'brief   : %s\n' "$BRIEF_ABS"
    printf 'deliver : %s\n' "${DELIVER:-<none>}"
    printf 'log     : %s\n' "$LOG"
    printf 'timeout : %ss\n' "$TIMEOUT"
    printf 'command : timeout %s' "$TIMEOUT"
    printf ' %q' "${CMD[@]}"; printf '\n'
    for p in "${!BEFORE[@]}"; do printf 'freeze  : %s  %s\n' "${BEFORE[$p]}" "$p"; done
    exit 0
fi

# The standing-gap fix: the brief must outlive the process that consumed it.
if [ -n "$DELIVER" ]; then
    cp -f "$BRIEF_ABS" "$DELIVER/.brief.md"
    printf '<!-- delegated %s · task %s · log %s -->\n' "$TS" "$TASK" "$LOG" \
        >> "$DELIVER/.brief.md"
fi

printf 'delegate-brief: task=%s cwd=%s timeout=%ss\n' "$TASK" "$WORK_CWD" "$TIMEOUT"
printf 'delegate-brief: log -> %s\n' "$LOG"
[ "$SKIP_PERMS" -eq 1 ] && printf 'delegate-brief: WARNING permission checks bypassed\n'

STARTED=$(date +%s)
( cd "$WORK_CWD" && timeout "$TIMEOUT" "${CMD[@]}" ) > "$LOG" 2>&1
EXIT_CODE=$?
ENDED=$(date +%s)
DURATION=$((ENDED - STARTED))

case "$EXIT_CODE" in
    0)   OUTCOME="completed" ;;
    124) OUTCOME="timed_out" ;;
    *)   OUTCOME="failed" ;;
esac

# ---- freeze verification ---------------------------------------------------
VIOLATIONS=()
for p in "${!BEFORE[@]}"; do
    now=$(manifest "$p")
    [ "$now" = "${BEFORE[$p]}" ] || VIOLATIONS+=("$p")
done

printf '\ndelegate-brief: outcome=%s exit=%s duration=%ss log_bytes=%s\n' \
    "$OUTCOME" "$EXIT_CODE" "$DURATION" "$(wc -c < "$LOG" | tr -d ' ')"
if [ "${#VIOLATIONS[@]}" -gt 0 ]; then
    printf 'delegate-brief: FREEZE VIOLATED (%s path(s)):\n' "${#VIOLATIONS[@]}"
    for v in "${VIOLATIONS[@]}"; do printf '  - %s\n' "$v"; done
else
    [ "${#BEFORE[@]}" -gt 0 ] && printf 'delegate-brief: freeze intact (%s path(s))\n' "${#BEFORE[@]}"
fi
printf 'delegate-brief: last log line: %s\n' "$(tail -n 1 "$LOG" 2>/dev/null)"

# ---- optional ledger handoff ----------------------------------------------
if [ "$RECORD" -eq 1 ]; then
    OP="$(dirname "$(readlink -f "$0")")/operator"
    if [ -x "$OP" ]; then
        frz="intact"
        [ "${#VIOLATIONS[@]}" -gt 0 ] && frz="VIOLATED: ${VIOLATIONS[*]}"
        "$OP" handoff-add --task "$TASK" --by claude \
            --changed "Delegated headless run against brief $BRIEF_ABS in $WORK_CWD. Deliverable: ${DELIVER:-unspecified}. Brief preserved at ${DELIVER:+$DELIVER/.brief.md}." \
            --verified "Wall-clock outcome only: outcome=$OUTCOME exit=$EXIT_CODE duration=${DURATION}s. Frozen paths $frz. No claim about whether the deliverable satisfies the brief's acceptance checklist." \
            --claimed "None. This handoff records dispatch and exit, not correctness." \
            --open "Acceptance checklist in the brief is unevaluated. Full run log at $LOG." \
            --assumptions "That the brief file at dispatch time is the governing brief." \
            --next-action "Read $LOG, then evaluate the brief's acceptance checklist against the deliverable before any deploy." \
            >/dev/null 2>&1 \
            && printf 'delegate-brief: handoff recorded on task %s\n' "$TASK" \
            || printf 'delegate-brief: handoff-add failed (task %s may not exist)\n' "$TASK" >&2
    fi
fi

[ "${#VIOLATIONS[@]}" -gt 0 ] && exit 1
exit "$EXIT_CODE"
