#!/usr/bin/env bash
#
# delegate-brief — launch a headless harness run against a written brief, with the
# brief preserved in the workspace and declared frozen paths checked mechanically.
#
# Harnesses (CLI headless backends that exist on this machine):
#   claude      Claude Code  (-p / --append-system-prompt-file)
#   codex       Codex CLI    (exec, workspace-write)
#   grok        Grok Build   (agentic session, always-approve)
#   gemini-agy  Gemini CLI or Antigravity agy (-p / --print)
#   fable       Claude Code with API-style model override (same binary as claude)
#   openrouter  Codex or Claude only if OR proxy configured — maps to codex when
#               `codex` is present, else fails with a clear message
#
# Local Ollama harness ids (gemma4_local, etc.) are recognized but not auto-launched
# as agent loops — there is no first-class multi-tool agent CLI for them yet.
#
# Standing properties (from 2026-08-07 incident rebuild):
#   1. Brief is a file, copied to DELIVER/.brief.md (survives the process).
#   2. --freeze paths are hashed before/after; drift fails the run.
#   3. Full log + exit code are always captured.
#
# Permission bypass is opt-in, not the default.
#
set -uo pipefail

TASK=""
BRIEF=""
HARNESS="claude"
WORK_CWD="$PWD"
DELIVER=""
PROMPT=""
MODEL=""
ALLOWED=""
TIMEOUT=1800
LOG=""
RECORD=0
DRY=0
SKIP_PERMS=0
SANDBOX="workspace-write"
MAX_TURNS=""
FREEZE=()

usage() {
    cat <<'EOF'
Usage: delegate-brief --task ID --brief FILE [options]

Required:
  --task ID              Operator task id this run is delegated under.
  --brief FILE           Markdown brief. Copied to DELIVER/.brief.md.
                         How the brief is injected depends on --harness.

Options:
  --harness ID           claude|codex|grok|gemini-agy|fable|openrouter
                         (default: claude). Must match a known headless backend.
  --cwd DIR              Working directory for the run (default: current).
  --deliver DIR          Deliverable directory; receives .brief.md.
  --freeze PATH          Path that must not change. Repeatable. Hashed before/after.
  --prompt TEXT          Kickoff prompt (default: execute the brief for the task).
  --allowed-tools LIST   Claude/Grok tool allowlist (vendor-specific).
  --model NAME           Model override where the vendor CLI supports it.
  --sandbox MODE         Codex only: read-only|workspace-write|danger-full-access
                         (default: workspace-write).
  --max-turns N          Grok only: max agent turns.
  --timeout SECS         Hard wall clock limit (default: 1800).
  --log FILE             Log path (default: <deliver-or-tmp>/delegate-<task>-<ts>.log).
  --skip-permissions     Vendor-specific auto-approve / bypass (opt-in; dangerous).
  --record               On exit, append an operator handoff with the real outcome.
  --dry-run              Print the command and freeze manifest; run nothing.
  -h, --help             This message.

Examples:
  ./delegate-brief --task front-e1-gold-pack --brief .operator/briefs/foo.codex.NOW.md \
      --harness codex --cwd . --deliver evals/.../e1-gold-pack \
      --freeze evals/local_lane_ladder/GOLD_STANDARD.md --record

  ./delegate-brief --task my-task --brief brief.md --harness claude --skip-permissions
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --task)            TASK="$2"; shift 2 ;;
        --brief)           BRIEF="$2"; shift 2 ;;
        --harness)         HARNESS="$2"; shift 2 ;;
        --cwd)             WORK_CWD="$2"; shift 2 ;;
        --deliver)         DELIVER="$2"; shift 2 ;;
        --freeze)          FREEZE+=("$2"); shift 2 ;;
        --prompt)          PROMPT="$2"; shift 2 ;;
        --allowed-tools)   ALLOWED="$2"; shift 2 ;;
        --model)           MODEL="$2"; shift 2 ;;
        --sandbox)         SANDBOX="$2"; shift 2 ;;
        --max-turns)       MAX_TURNS="$2"; shift 2 ;;
        --timeout)         TIMEOUT="$2"; shift 2 ;;
        --log)             LOG="$2"; shift 2 ;;
        --skip-permissions) SKIP_PERMS=1; shift ;;
        --record)          RECORD=1; shift ;;
        --dry-run)         DRY=1; shift ;;
        -h|--help)         usage; exit 0 ;;
        *) printf 'delegate-brief: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

die() { printf 'delegate-brief: %s\n' "$1" >&2; exit 2; }

[ -n "$TASK" ]  || die "--task is required"
[ -n "$BRIEF" ] || die "--brief is required"
[ -f "$BRIEF" ] || die "brief not found: $BRIEF"
[ -d "$WORK_CWD" ] || die "cwd not found: $WORK_CWD"

BRIEF_ABS=$(readlink -f "$BRIEF")
WORK_CWD=$(readlink -f "$WORK_CWD")
TS=$(date +%Y%m%dT%H%M%S)
HARNESS=$(printf '%s' "$HARNESS" | tr '[:upper:]' '[:lower:]')

if [ -n "$DELIVER" ]; then
    mkdir -p "$DELIVER" || die "cannot create deliverable dir: $DELIVER"
    DELIVER=$(readlink -f "$DELIVER")
fi
if [ -z "$LOG" ]; then
    LOG="${DELIVER:-/tmp}/delegate-${TASK}-${HARNESS}-${TS}.log"
fi

# ---- freeze manifest -------------------------------------------------------
manifest() {
    local p="$1"
    if [ -d "$p" ]; then
        find "$p" -type f -print0 2>/dev/null | LC_ALL=C sort -z \
            | xargs -0 -r sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1
    elif [ -f "$p" ]; then
        sha256sum "$p" | cut -d' ' -f1
    else
        printf 'ABSENT'
    fi
}

declare -A BEFORE
for p in ${FREEZE+"${FREEZE[@]}"}; do
    abs=$(readlink -f "$p" 2>/dev/null || printf '%s' "$p")
    BEFORE["$abs"]=$(manifest "$abs")
    if [ "${BEFORE[$abs]}" = "ABSENT" ]; then
        printf 'delegate-brief: warning: frozen path does not exist: %s\n' "$abs" >&2
    fi
done

# ---- default prompt --------------------------------------------------------
if [ -z "$PROMPT" ]; then
    PROMPT="Execute the brief for Operator task ${TASK}. The brief file is the governing instructions — honor every constraint literally, including frozen paths and deliverable restrictions. Do not deploy to production. If the brief conflicts with anything else, stop and report the conflict rather than choosing."
fi

# Combined user message used by vendors that take a single prompt string
# (brief content inlined so it is not lost when the vendor has no system-file flag).
compose_inline_prompt() {
    printf '%s\n\n--- BEGIN BRIEF (%s) ---\n' "$PROMPT" "$BRIEF_ABS"
    cat "$BRIEF_ABS"
    printf '\n--- END BRIEF ---\n'
}

# ---- build CMD array per harness -------------------------------------------
# Sets global: CMD (array), HANDOFF_BY (string for --by)
build_cmd() {
    local need
    HANDOFF_BY="$HARNESS"
    case "$HARNESS" in
        claude)
            need=claude
            command -v claude >/dev/null || die "claude not on PATH"
            CMD=(claude -p "$PROMPT" --append-system-prompt-file "$BRIEF_ABS")
            [ -n "$ALLOWED" ] && CMD+=(--allowedTools "$ALLOWED")
            [ -n "$MODEL" ]   && CMD+=(--model "$MODEL")
            [ "$SKIP_PERMS" -eq 1 ] && CMD+=(--dangerously-skip-permissions)
            ;;
        fable)
            # Fable is Claude API metering; same CLI binary, model from registry default or --model
            need=claude
            command -v claude >/dev/null || die "claude not on PATH (fable uses Claude Code CLI)"
            HANDOFF_BY=fable
            CMD=(claude -p "$PROMPT" --append-system-prompt-file "$BRIEF_ABS")
            if [ -n "$MODEL" ]; then
                CMD+=(--model "$MODEL")
            else
                CMD+=(--model "claude-3-5-sonnet-20241022")
            fi
            [ -n "$ALLOWED" ] && CMD+=(--allowedTools "$ALLOWED")
            [ "$SKIP_PERMS" -eq 1 ] && CMD+=(--dangerously-skip-permissions)
            ;;
        codex|openrouter)
            # openrouter: no first-class agent CLI; if user has codex pointed at OR, use codex
            if [ "$HARNESS" = openrouter ]; then
                HANDOFF_BY=openrouter
                printf 'delegate-brief: note: openrouter maps to codex exec (configure OR on that CLI if needed)\n' >&2
            fi
            need=codex
            command -v codex >/dev/null || die "codex not on PATH"
            # Inline brief: codex exec has no --append-system-prompt-file
            local combined
            combined=$(compose_inline_prompt)
            CMD=(codex exec -C "$WORK_CWD" -s "$SANDBOX" --skip-git-repo-check)
            [ -n "$MODEL" ] && CMD+=(-m "$MODEL")
            [ "$SKIP_PERMS" -eq 1 ] && CMD+=(--dangerously-bypass-approvals-and-sandbox)
            CMD+=("$combined")
            ;;
        grok)
            need=grok
            command -v grok >/dev/null || die "grok not on PATH"
            # Full agent session, not single-turn -p (which is one shot without tools loop)
            CMD=(grok --cwd "$WORK_CWD" --always-approve --permission-mode auto)
            [ -n "$MODEL" ] && CMD+=(-m "$MODEL")
            [ -n "$MAX_TURNS" ] && CMD+=(--max-turns "$MAX_TURNS")
            [ -n "$ALLOWED" ] && CMD+=(--allow "$ALLOWED")
            # Append brief as rules so it is not only in argv length limits alone
            CMD+=(--rules "$(cat "$BRIEF_ABS")")
            [ "$SKIP_PERMS" -eq 1 ] && CMD+=(--permission-mode bypassPermissions)
            CMD+=("$PROMPT")
            ;;
        gemini-agy|gemini|agy)
            HANDOFF_BY=gemini-agy
            if command -v agy >/dev/null 2>&1; then
                need=agy
                local combined
                combined=$(compose_inline_prompt)
                CMD=(agy -p "$combined")
                [ -n "$MODEL" ] && CMD+=(--model "$MODEL")
                [ "$SKIP_PERMS" -eq 1 ] && CMD+=(--dangerously-skip-permissions)
            elif command -v gemini >/dev/null 2>&1; then
                need=gemini
                local combined
                combined=$(compose_inline_prompt)
                CMD=(gemini -p "$combined")
                [ -n "$MODEL" ] && CMD+=(-m "$MODEL")
            else
                die "neither agy nor gemini on PATH (harness gemini-agy)"
            fi
            ;;
        gemma3_local|gemma4_local|gpt-oss_local|gemma3|gemma4)
            die "harness '$HARNESS' is a local model seat, not a headless agent CLI. Use ollama + a thin runner, or assign a frontier harness (claude/codex/grok)."
            ;;
        copilot)
            die "harness 'copilot' has no headless delegate backend wired yet"
            ;;
        *)
            die "unknown harness '$HARNESS'. Supported: claude, codex, grok, gemini-agy, fable, openrouter"
            ;;
    esac
    unset need
}

build_cmd

# ---- MCP preflight (Claude only; others ignore) ----------------------------
if [ "$HARNESS" = claude ] || [ "$HARNESS" = fable ]; then
    if [ -n "$ALLOWED" ] && printf '%s' "$ALLOWED" | grep -q 'mcp__'; then
        srv=$(printf '%s' "$ALLOWED" | tr ', ' '\n\n' | sed -n 's/^mcp__\(..*\)$/\1/p' \
                | sed 's/__.*$//' | sort -u)
        for s in $srv; do
            if ! (cd "$WORK_CWD" && claude mcp list 2>/dev/null) | grep -q "\b${s}\b"; then
                printf 'delegate-brief: warning: MCP server %s not listed for cwd %s\n' \
                    "$s" "$WORK_CWD" >&2
            fi
        done
    fi
fi

if [ "$DRY" -eq 1 ]; then
    printf 'harness : %s\n' "$HARNESS"
    printf 'cwd     : %s\n' "$WORK_CWD"
    printf 'brief   : %s\n' "$BRIEF_ABS"
    printf 'deliver : %s\n' "${DELIVER:-<none>}"
    printf 'log     : %s\n' "$LOG"
    printf 'timeout : %ss\n' "$TIMEOUT"
    printf 'command : timeout %s' "$TIMEOUT"
    # Avoid dumping megabyte inline prompts in dry-run — show first arg shape
    printf ' %q' "${CMD[0]}"
    local_i=1
    while [ "$local_i" -lt "${#CMD[@]}" ]; do
        arg="${CMD[$local_i]}"
        if [ "${#arg}" -gt 120 ]; then
            printf ' %q' "${arg:0:80}…($((${#arg})) bytes)"
        else
            printf ' %q' "$arg"
        fi
        local_i=$((local_i + 1))
    done
    printf '\n'
    for p in "${!BEFORE[@]}"; do printf 'freeze  : %s  %s\n' "${BEFORE[$p]}" "$p"; done
    exit 0
fi

# Brief must outlive the process
if [ -n "$DELIVER" ]; then
    cp -f "$BRIEF_ABS" "$DELIVER/.brief.md"
    printf '<!-- delegated %s · task %s · harness %s · log %s -->\n' \
        "$TS" "$TASK" "$HARNESS" "$LOG" >> "$DELIVER/.brief.md"
fi

printf 'delegate-brief: task=%s harness=%s cwd=%s timeout=%ss\n' \
    "$TASK" "$HARNESS" "$WORK_CWD" "$TIMEOUT"
printf 'delegate-brief: log -> %s\n' "$LOG"
[ "$SKIP_PERMS" -eq 1 ] && printf 'delegate-brief: WARNING permission checks bypassed\n'

STARTED=$(date +%s)
# codex/grok may inherit odd stdin; close it so headless does not hang on "Reading stdin"
( cd "$WORK_CWD" && timeout "$TIMEOUT" "${CMD[@]}" </dev/null ) > "$LOG" 2>&1
EXIT_CODE=$?
ENDED=$(date +%s)
DURATION=$((ENDED - STARTED))

case "$EXIT_CODE" in
    0)   OUTCOME="completed" ;;
    124) OUTCOME="timed_out" ;;
    *)   OUTCOME="failed" ;;
esac

# ---- freeze verification ---------------------------------------------------
VIOLATIONS=()
for p in "${!BEFORE[@]}"; do
    now=$(manifest "$p")
    [ "$now" = "${BEFORE[$p]}" ] || VIOLATIONS+=("$p")
done

printf '\ndelegate-brief: outcome=%s exit=%s duration=%ss log_bytes=%s\n' \
    "$OUTCOME" "$EXIT_CODE" "$DURATION" "$(wc -c < "$LOG" | tr -d ' ')"
if [ "${#VIOLATIONS[@]}" -gt 0 ]; then
    printf 'delegate-brief: FREEZE VIOLATED (%s path(s)):\n' "${#VIOLATIONS[@]}"
    for v in "${VIOLATIONS[@]}"; do printf '  - %s\n' "$v"; done
else
    [ "${#BEFORE[@]}" -gt 0 ] && printf 'delegate-brief: freeze intact (%s path(s))\n' "${#BEFORE[@]}"
fi
printf 'delegate-brief: last log line: %s\n' "$(tail -n 1 "$LOG" 2>/dev/null)"

# ---- optional ledger handoff ----------------------------------------------
if [ "$RECORD" -eq 1 ]; then
    OP="$(dirname "$(readlink -f "$0")")/operator"
    if [ -x "$OP" ]; then
        frz="intact"
        [ "${#VIOLATIONS[@]}" -gt 0 ] && frz="VIOLATED: ${VIOLATIONS[*]}"
        "$OP" handoff-add --task "$TASK" --by "$HANDOFF_BY" \
            --changed "Delegated headless run (harness=$HARNESS) against brief $BRIEF_ABS in $WORK_CWD. Deliverable: ${DELIVER:-unspecified}. Brief preserved at ${DELIVER:+$DELIVER/.brief.md}." \
            --verified "Wall-clock outcome only: outcome=$OUTCOME exit=$EXIT_CODE duration=${DURATION}s. Frozen paths $frz. No claim about whether the deliverable satisfies the brief's acceptance checklist." \
            --claimed "None. This handoff records dispatch and exit, not correctness." \
            --open "Acceptance checklist in the brief is unevaluated. Full run log at $LOG." \
            --assumptions "That the brief file at dispatch time is the governing brief. Harness backend=$HARNESS." \
            --next-action "Read $LOG, then evaluate the brief's acceptance checklist against the deliverable before any deploy." \
            >/dev/null 2>&1 \
            && printf 'delegate-brief: handoff recorded on task %s (by=%s)\n' "$TASK" "$HANDOFF_BY" \
            || printf 'delegate-brief: handoff-add failed (task %s may not exist)\n' "$TASK" >&2
    fi
fi

[ "${#VIOLATIONS[@]}" -gt 0 ] && exit 1
exit "$EXIT_CODE"
